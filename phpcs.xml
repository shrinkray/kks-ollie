<?xml version="1.0"?>
<ruleset name="KKS Ollie WordPress theme rules">
	<description>kks-ollie PHPCS: WordPress-Extra (same as legacy composer flags) plus PHPCompatibility.</description>

	<!-- Mirrors prior CLI: skip WordPress.WP.I18n until text domains are audited. -->
	<rule ref="WordPress.WP.I18n">
		<severity>0</severity>
	</rule>

	<!--
		WPCS 2.x on PHPCS 3.13: WordPress-Extra still references core sniffs PHPCS deprecated.
		Exclude those and use Generic.WhiteSpace.LanguageConstructSpacing instead of Squiz.*
	-->
	<rule ref="WordPress-Extra">
		<exclude name="Generic.Functions.CallTimePassByReference"/>
		<exclude name="Squiz.WhiteSpace.LanguageConstructSpacing"/>
		<exclude name="WordPress.WhiteSpace.PrecisionAlignment"/>
	</rule>
	<rule ref="Generic.WhiteSpace.LanguageConstructSpacing"/>

	<rule ref="PHPCompatibility"/>
	<config name="testVersion" value="8.1-"/>

	<arg name="extensions" value="php"/>
	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
</ruleset>
